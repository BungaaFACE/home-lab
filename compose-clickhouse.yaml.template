services:
  clickhouse:
    image: clickhouse/clickhouse-server:25.8
    container_name: clickhouse
    ports:
      - "8123:8123"
      - "9000:9000"
    environment:
      CLICKHOUSE_USER: user
      CLICKHOUSE_PASSWORD: password
      CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT: "1"
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    volumes:
      - ${DATA_PATH}/clickhouse/clickhouse_data:/var/lib/clickhouse
      - ${DATA_PATH}/clickhouse/init.sql:/docker-entrypoint-initdb.d/01-geo.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "clickhouse-client --user user --password password --query 'SELECT 1'"]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 10s
